# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings (personal/machine-specific, not shared)
.claude/settings.local.json

# raw/unprocessed source media — not referenced by the site; processed,
# in-use copies live under public/images/
*.HEIC
IMG_*.MOV
WhatsApp Image*.jpeg
tedx photo for web/
tedx photo new/
illustrated+man+3d+model.obj
